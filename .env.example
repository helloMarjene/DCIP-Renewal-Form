# Copy this file to ".env" and fill in your own values.
# Never share your .env file or commit it to any public place.

PORT=3000

# Where the "new renewal" notification email is sent (the Bishop/leader)
DCNI_ADMIN_EMAIL=

# Email sending — using Gmail SMTP is the simplest option:
# 1. Use a Google account.
# 2. Turn on 2-Step Verification: https://myaccount.google.com/security
# 3. Create an "App Password": https://myaccount.google.com/apppasswords
# 4. Put that Google account address as SMTP_USER, and the 16-character
#    app password (no spaces) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Admin dashboard login (http://localhost:3000/admin)
ADMIN_USER=admin
ADMIN_PASS=changeme

# WhatsApp Business Platform (optional — leave WHATSAPP_ENABLED=false
# until you have set this up through Meta's official Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_ADMIN_NUMBER=
